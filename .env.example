# ==============================================================================
# AI AFFILIATE COMMAND CENTER - BIẾN MÔI TRƯỜNG MẪU (.env)
# ==============================================================================

# 1. Frontend Supabase Client (Vite)
# VITE_SUPABASE_URL: URL dự án Supabase (vd: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# VITE_SUPABASE_ANON_KEY: Khóa công khai anon/publishable key (tuyệt đối không dùng service_role)
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# 2. Supabase Edge Functions Secrets (Cấu hình trên Supabase CLI hoặc Dashboard)
# Chạy: supabase secrets set GEMINI_API_KEY="your_api_key" GEMINI_MODEL="gemini-3.8-flash"
# Lưu ý: Không để GEMINI_API_KEY ở biến môi trường frontend có tiền tố VITE_
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.8-flash"

# 3. Môi trường AI Studio Cloud Run (Tự động thiết lập)
APP_URL="MY_APP_URL"
